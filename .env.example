DATABASE_URL=postgresql://oddstage:oddstage@localhost:5433/oddstage
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TEST_DATABASE_URL=postgresql://oddstage:oddstage@localhost:5433/oddstage_test
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Required when PUBLIC_BASE_URL is https
SESSION_SECRET=
# Unlocks the replay curation endpoint; empty turns it off
CURATOR_TOKEN=
# Sign-in providers; each one shows only when both its values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# models.yaml entries: the judge, the AI player, and the hosted model that stands in when a
# self-hosted AI player fails. The -direct entries call DeepSeek with DEEPSEEK_API_KEY.
JUDGE_REF=judge-v1
OPPONENT_REF=opponent-v1
FALLBACK_REF=opponent-v1
# A YAML file of extra model entries, kept out of git
EXTRA_MODELS_PATH=
# Bearer key for a self-hosted House (OPPONENT_REF=student-cloud)
HOUSE_API_KEY=
HOUSE_BASE_URL=
GCP_PROJECT=
GCP_BILLING_ACCOUNT=
# Model calls are traced to Langfuse when both keys are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Training runs log here with --track
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# No new match starts once the day's model spend in dollars reaches this; empty means no cap
DAILY_CAP_USD=
# Required when PUBLIC_BASE_URL is https; Cloudflare's test keys are used otherwise
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
